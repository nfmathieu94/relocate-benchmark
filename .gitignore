# Large caller run outputs and alignments (regenerable)
runs/*
!runs/.gitkeep

# Derived external annotations (regenerated deterministically from configured source)
cache/

# Logs
logs/*
!logs/.gitkeep
*.log

# Large per-sample match tables
reports/per_sample/*
!reports/.gitkeep

# Per-sample resource outputs (regenerable per-run); combined reports/*.tsv stay tracked
reports/resources/
reports/datasets/

# Standalone publication figures (large, regenerable by make_report.R)
reports/figures/

# Per-run caller ranking reports (regenerable by scoring/rank_callers.py)
reports/caller_ranking_*.md

# Truth completion sentinel (data itself is small + tracked)
truth/.complete
truth/*/

# Python
__pycache__/
*.pyc
.pytest_cache/

# pixi materialized environments (regenerable from committed pixi.lock)
.pixi/
**/.pixi/

# RelocaTE2 BioContainer images (large; regenerable from callers/relocate2/images.txt)
callers/relocate2/images/

# Stray samtools/bwa temp files left by interrupted pipes (e.g. STDIN.tmp.0024.bam)
STDIN.tmp.*
