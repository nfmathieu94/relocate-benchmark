# Large caller run outputs and alignments (regenerable)
runs/*
!runs/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Large per-sample match tables
reports/per_sample/*
!reports/.gitkeep

# Per-sample resource outputs (regenerable per-run); combined reports/*.tsv stay tracked
reports/resources/

# Standalone publication figures (large, regenerable by make_report.R)
reports/figures/

# Truth completion sentinel (data itself is small + tracked)
truth/.complete

# Python
__pycache__/
*.pyc
.pytest_cache/

# pixi materialized environments (regenerable from committed pixi.lock)
.pixi/
**/.pixi/
